#!/bin/sh
# Before a push: say when CI is already red, refuse a push to any branch but main (work goes straight to main, the
# user's rule of 26 November 2026), refuse the push when the type check fails, then watch the CI run of what is pushed and raise a desktop notification if it fails
# (scripts/ci-guard.mjs). The full test suite and the browser tests stay in CI (four jobs).
# A post-commit hook could not help here: CI runs on push, so there is nothing to check yet after a commit.
branch=$(git rev-parse --abbrev-ref HEAD)
node scripts/ci-guard.mjs status "$branch"

# The commits being pushed arrive on stdin as "<local ref> <local sha> <remote ref> <remote sha>".
pushed=$(cat)

# No branches: only main (and tags) take commits. Deleting a branch (an all-zero local sha) is allowed.
echo "$pushed" | while read -r _ local_sha remote_ref _; do
  case "$local_sha" in 0000000000000000000000000000000000000000|"") continue ;; esac
  case "$remote_ref" in refs/heads/main|refs/tags/*) ;; *)
    echo "pre-push: $remote_ref refused. Work goes straight to main, never to a branch: git push origin HEAD:main" >&2
    exit 1 ;;
  esac
done || exit 1

# Main deploys at once, so every migration is applied to the live database before the push (the user's rule,
# 26 November 2026). Skipped when .env names no database or it cannot be reached.
echo "pre-push: checking the live database has every migration"
if ! node scripts/check-migrations.mjs --strict; then
  echo "pre-push: push aborted. Apply the migrations above to Supabase first (docs/agents/database-and-tests.md)." >&2
  exit 1
fi

echo "pre-push: running npm run typecheck"
if ! npm run typecheck --silent; then
  echo "pre-push: type check failed, push aborted. Fix the errors above and push again." >&2
  exit 1
fi

echo "$pushed" | while read -r _ local_sha _ _; do
  case "$local_sha" in 0000000000000000000000000000000000000000|"") ;; *) node scripts/ci-guard.mjs spawn-watch "$local_sha" ;; esac
done
exit 0
