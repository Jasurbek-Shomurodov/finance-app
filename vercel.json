{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npx next build --webpack",
  "devCommand": "npx next dev --port 5000",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/portfolio-snapshots",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/telegram-digest",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/telegram-recap",
      "schedule": "0 15 * * 0"
    },
    {
      "path": "/api/cron/telegram-monthly",
      "schedule": "0 5 1 * *"
    }
  ]
}
